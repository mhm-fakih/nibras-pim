<?xml version="1.0" encoding="utf-8"?>
<!-- The "Add a task…" bar on the Today's tasks widget.

     Drawn to look like a text field because that is what it stands in for. A home-screen widget
     cannot contain a real one — RemoteViews has no editable view at any API level — so the bar is
     a TextView that opens QuickTaskActivity, which has the actual input. The outline is what tells
     the user it is typing-shaped rather than another row of the list. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#2A2A2E" />
    <stroke
        android:width="1dp"
        android:color="#4A4A50" />
    <corners android:radius="8dp" />
</shape>
