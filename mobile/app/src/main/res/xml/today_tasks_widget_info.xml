<?xml version="1.0" encoding="utf-8"?>
<!-- A title, an add bar and a list need room: 2 cells wide by 2 tall (70*2-30 = 110dp) is the
     smallest at which the add bar and a couple of rows are both legible. updatePeriodMillis is a
     backstop only — the widget is redrawn the moment a task is added, and by the shared
     Widgets.refreshAll. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_today_tasks"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
