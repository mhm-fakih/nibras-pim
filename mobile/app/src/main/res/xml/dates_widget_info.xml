<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: the three dates, and three days of occasions under them. updatePeriodMillis is the
     backstop for the date turning over (the widget is also redrawn when the app refreshes the
     official calendar, at boot and on a tap). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_dates"
    android:minHeight="110dp"
    android:minResizeHeight="60dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
