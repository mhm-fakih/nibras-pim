    <string name="prayer_no_upcoming">Aucun horaire à venir — toutes les lignes sont masquées, ou le soleil n’atteint jamais ces angles ici.</string>
    <string name="prayer_alarms_off_warning">Les alertes sont désactivées — les horaires restent affichés, mais rien ne sonnera.</string>
    <string name="prayer_athan_on_cd">Adhan activé</string>
    <string name="prayer_which_times">Horaires à afficher</string>
    <string name="prayer_adjust_title">Ajuster chaque horaire</string>
    <string name="prayer_adjust_note">Minutes ajoutées à l’horaire calculé, ou retirées. C’est ainsi que vous vous alignez sur la mosquée où vous priez réellement — aucune méthode de calcul ne s’accordera avec toutes.</string>
    <string name="prayer_earlier_cd">%1$s plus tôt</string>
    <string name="prayer_later_cd">%1$s plus tard</string>
    <string name="prayer_reset">réinitialiser</string>
    <string name="prayer_school_title">École — début de l’Asr</string>
    <string name="prayer_school_note">Les deux lectures diffèrent d’environ une heure en été. C’est le réglage le plus susceptible de mettre l’appli en désaccord avec la mosquée du quartier.</string>
    <string name="prayer_method_title">Méthode de calcul</string>
    <string name="prayer_method_note">La profondeur sous l’horizon que le soleil doit atteindre pour le Fajr et l’Icha. Les méthodes chiite duodécimaine et de Téhéran retardent aussi le Maghrib jusqu’à ce que le soleil soit 4° sous l’horizon, plutôt qu’au coucher.</string>
    <string name="prayer_method_fajr_angle">Fajr %1$s°</string>
    <string name="prayer_method_isha_angle">Icha %1$s°</string>
    <string name="prayer_method_isha_minutes">Icha %1$d min après le Maghrib</string>
    <string name="prayer_method_maghrib_angle">Maghrib %1$s°</string>
    <string name="prayer_location_title">Votre position</string>
    <string name="prayer_highlat_title">Nuits du Grand Nord</string>
    <string name="prayer_highlat_note">Au-delà d’environ 48°, certaines nuits d’été le soleil ne descend jamais assez bas pour que le Fajr ou l’Icha existent. Laissez « Aucune » sauf si une ligne reste vide.</string>
    <string name="prayer_latitude">Latitude</string>
    <string name="prayer_longitude">Longitude</string>
    <string name="prayer_place_name">Nom du lieu (affiché en haut)</string>
    <string name="prayer_use_location">Utiliser ma position</string>
    <string name="prayer_location_note">Uniquement des coordonnées, et seulement quand vous appuyez sur le bouton — rien n’est recherché en ligne et rien ne quitte le téléphone.</string>
    <string name="prayer_alarms_on">Alertes activées</string>
    <string name="prayer_alarms_on_note">L’interrupteur principal. Désactivé, la page affiche toujours les horaires, mais rien ne sonne et aucune alarme n’est programmée.</string>
    <string name="prayer_in_app">Horaires de prière dans l’appli</string>
    <string name="prayer_in_app_note">Désactivé, la page quitte la barre latérale et rien n’est programmé. Les paramètres affichent alors une ligne pour la rétablir — cet interrupteur disparaît avec la page.</string>
    <string name="prayer_call_athan_at">Appeler l’adhan à</string>
    <string name="prayer_shurooq_note">Le Chourouq est le lever du soleil, pas une prière : il ne figure donc jamais dans cette liste.</string>
    <string name="prayer_choose_athan_file">Choisir un fichier d’adhan</string>
    <string name="prayer_hear_it">Écouter</string>
    <string name="prayer_athan_file_note">N’importe quel fichier audio du téléphone. Joué sur le flux d’alarme, il reste audible même quand le téléphone est en silence pour la prière ci-dessous.</string>
    <string name="prayer_volume_each">Volume pour chacune</string>
    <string name="prayer_volume_note">Règle le volume d\'alarme du téléphone à ce niveau pendant l\'athan, puis le remet — 25 % sonne donc pareil, quel que soit le volume d\'alarme laissé. 0 coupe celui-ci.</string>
    <string name="prayer_volume_muted">%1$s  muet</string>
    <string name="prayer_volume_percent">%1$s  %2$d %%</string>
    <string name="prayer_hear_colon">Écouter :</string>
    <string name="prayer_widget_countdown">Compte à rebours du widget</string>
    <string name="prayer_widget_countdown_note">La barre de l’écran d’accueil n’affiche son compte à rebours que lorsque le prochain horaire est aussi proche. Affiché toute la journée, il indiquait « 5:31:23 » — un nombre dont personne ne fait rien, dans la seule ligne libre de la barre.</string>
    <string name="prayer_remind_before">Me rappeler avant chaque horaire</string>
    <string name="prayer_remind_before_note">Une notification discrète avant chaque horaire que vous avez choisi d’afficher.</string>
    <string name="prayer_min_before">%1$d min avant</string>
    <string name="prayer_hours_before">%1$d h avant</string>
    <string name="prayer_hours_minutes_before">%1$d h %2$d min avant</string>
    <string name="prayer_countdown_always">toujours affiché</string>
    <string name="prayer_beeps_before">Bips avant le Chourouq</string>
    <string name="prayer_beeps_note">Le lever du soleil clôt le temps du Fajr, il a donc son propre compte à rebours. Les bips sonnent sur le flux d’alarme, pour être entendus par une personne endormie.</string>
    <plurals name="prayer_beeps_count">
