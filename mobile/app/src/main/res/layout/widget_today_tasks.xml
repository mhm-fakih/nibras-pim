<?xml version="1.0" encoding="utf-8"?>
<!-- Today's tasks: a title, an add bar, then the scrolling list.

     The add bar is a TextView, not an EditText, and cannot be anything else: RemoteViews supports
     no editable view on any Android version. Tapping it opens QuickTaskActivity — a small floating
     input over the home screen — which writes the note and refreshes this widget, so the task
     appears here the moment it is entered. Same 12dp frame and 14sp bold title as the other list
     widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Title row: name left, count as a right-floated badge (see widget_single_list). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tt_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:gravity="center"
            android:minWidth="26dp"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textColor="#8AB4F8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tt_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_input_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:text="@string/widgets_today_tasks_add"
        android:textColor="#9AA0A6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/tt_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="6dp" />
</LinearLayout>
