<?xml version="1.0" encoding="utf-8"?>
<!-- "Volumes" widget: the volume streams you can actually SEE AND SET — Ring, Notif, Alarm,
     Music, System — as icon + read-only bar (no numeric values), in three columns.

     In-call volume (STREAM_VOICE_CALL) was here and is deliberately gone. Android does not put it
     on the Sounds and vibration screen at all: it is adjustable only with the volume keys while a
     call is in progress. So its bar could not be checked against anything, sat near full because
     that is its usual default, and — being a second telephone handset beside the ring icon —
     was read as the ring bar. A widget that reports a number the user cannot verify or change is
     worse than one that leaves it out.

     Every remaining icon has its own silhouette. With no labels here, the glyph is the only thing
     naming a bar.

     Bars are coloured by headroom (green / orange within 20% of the top / red at maximum) and are
     measured on each stream's own min..max, so streams with different ranges read alike — see
     PhoneStatusWidget.levelColor. Frame/typography match the bookmarks widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/ps_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="@string/widgets_phone_volumes"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Column 1: Ring / Notif -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/widgets_phone_ring"
                    android:src="@drawable/ic_vol_ring" />
                <ProgressBar
                    android:id="@+id/ps_bar_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#81C784" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/widgets_phone_notification"
                    android:src="@drawable/ic_vol_notif" />
                <ProgressBar
                    android:id="@+id/ps_bar_notif"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#81C784" />
            </LinearLayout>
        </LinearLayout>

        <!-- Column 2: Alarm / Music -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/widgets_phone_alarm"
                    android:src="@drawable/ic_vol_alarm" />
                <ProgressBar
                    android:id="@+id/ps_bar_alarm"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#81C784" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/widgets_phone_music"
                    android:src="@drawable/ic_vol_music" />
                <ProgressBar
                    android:id="@+id/ps_bar_music"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#81C784" />
            </LinearLayout>
        </LinearLayout>

        <!-- Column 3: Call / System -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/widgets_phone_system"
                    android:src="@drawable/ic_vol_system" />
                <ProgressBar
                    android:id="@+id/ps_bar_system"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:progressTint="#81C784" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
