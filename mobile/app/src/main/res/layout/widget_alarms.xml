<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown to the day's remaining alarms.

     A fixed set of three rows rather than a ListView: this widget shows what is NEXT, and three is
     already more than a glance needs. A RemoteViewsFactory would cost a service and an IPC per
     redraw for rows that are recomputed every minute anyway. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/aw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Alarms"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aw_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/aw_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/aw_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textSize="13sp" />
</LinearLayout>
