<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the tasks board: up to four tasks side by side, as plain text on the widget card
     (no box behind each task), like the other list widgets. The code shows as many cells as
     the columns setting asks for, and hides (keeping their width) the unused ones on a group's last
     line so the columns stay aligned. No textAlignment: the default follows each task's own text, so an
     Arabic task sits at the right edge (viewStart pinned it to the left, the widget's edge). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/board_cell_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="#EEEEEE" />

    <TextView
        android:id="@+id/board_cell_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="#EEEEEE" />

    <TextView
        android:id="@+id/board_cell_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="#EEEEEE" />

    <TextView
        android:id="@+id/board_cell_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="2dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="#EEEEEE" />
</LinearLayout>
