    <string name="prayer_no_upcoming">No upcoming time — every row is hidden, or the sun never reaches these angles here.</string>
    <string name="prayer_alarms_off_warning">Alarms are switched off — the times are still shown, but nothing will sound.</string>
    <string name="prayer_athan_on_cd">Athan on</string>
    <string name="prayer_which_times">Which times to show</string>
    <string name="prayer_adjust_title">Adjust each time</string>
    <string name="prayer_adjust_note">Minutes added to, or taken off, the calculated time. This is how you match the mosque you actually pray at — no calculation method will agree with every one of them.</string>
    <string name="prayer_earlier_cd">Earlier %1$s</string>
    <string name="prayer_later_cd">Later %1$s</string>
    <string name="prayer_reset">reset</string>
    <string name="prayer_school_title">School — when Asr begins</string>
    <string name="prayer_school_note">The two readings differ by about an hour in summer. This is the setting most likely to make the app disagree with the mosque down the road.</string>
    <string name="prayer_method_title">Calculation method</string>
    <string name="prayer_method_note">How far below the horizon the sun must be for Fajr and Isha. Shia Ithna-ʿAshari and Tehran also hold Maghrib back until the sun is 4° down, rather than at sunset.</string>
    <string name="prayer_method_fajr_angle">Fajr %1$s°</string>
    <string name="prayer_method_isha_angle">Isha %1$s°</string>
    <string name="prayer_method_isha_minutes">Isha %1$d min after Maghrib</string>
    <string name="prayer_method_maghrib_angle">Maghrib %1$s°</string>
    <string name="prayer_location_title">Where you are</string>
    <string name="prayer_highlat_title">Far-north nights</string>
    <string name="prayer_highlat_note">Above about 48° there are summer nights when the sun never gets low enough for Fajr or Isha to exist at all. Leave this at None unless you see a blank row.</string>
    <string name="prayer_latitude">Latitude</string>
    <string name="prayer_longitude">Longitude</string>
    <string name="prayer_place_name">Place name (shown at the top)</string>
    <string name="prayer_use_location">Use my location</string>
    <string name="prayer_location_note">Coordinates only, and only when you press the button — nothing is looked up online and nothing leaves the phone.</string>
    <string name="prayer_alarms_on">Alarms on</string>
    <string name="prayer_alarms_on_note">The master switch. Off, the page still shows the times but nothing sounds and no alarm is set.</string>
    <string name="prayer_in_app">Prayer times in the app</string>
    <string name="prayer_in_app_note">Off, the page leaves the left rail and nothing is scheduled. Settings then shows a row to bring it back — this switch goes with the page.</string>
    <string name="prayer_call_athan_at">Call the athan at</string>
    <string name="prayer_shurooq_note">Shurooq is sunrise, not a prayer, so it is never on this list.</string>
    <string name="prayer_choose_athan_file">Choose athan file</string>
    <string name="prayer_hear_it">Hear it</string>
    <string name="prayer_athan_file_note">Any audio file on the phone. Played on the alarm stream, so it is still heard while the phone is silenced for the prayer below.</string>
    <string name="prayer_volume_each">Volume for each</string>
    <string name="prayer_volume_note">Sets the phone\'s alarm volume to this level while the athan plays, then puts it back — so 25% is the same loudness whatever the alarm volume was left at. 0 mutes that one.</string>
    <string name="prayer_volume_muted">%1$s  muted</string>
    <string name="prayer_volume_percent">%1$s  %2$d%%</string>
    <string name="prayer_hear_colon">Hear:</string>
    <string name="prayer_widget_countdown">Widget countdown</string>
    <string name="prayer_widget_countdown_note">The home-screen strip shows its countdown only once the next time is this close. Drawn all day it read \"5:31:23\" — a number nobody acts on, in the one spare line the strip has.</string>
    <string name="prayer_remind_before">Remind me before each time</string>
    <string name="prayer_remind_before_note">A quiet notification ahead of every time you have chosen to show.</string>
    <string name="prayer_min_before">%1$d min before</string>
    <string name="prayer_hours_before">%1$dh before</string>
    <string name="prayer_hours_minutes_before">%1$dh %2$dm before</string>
    <string name="prayer_countdown_always">always showing</string>
    <string name="prayer_beeps_before">Beeps before Shurooq</string>
    <string name="prayer_beeps_note">Sunrise closes the window in which Fajr can still be prayed, so it gets a countdown of its own. Beeps sound on the alarm stream, to be heard by someone asleep.</string>
